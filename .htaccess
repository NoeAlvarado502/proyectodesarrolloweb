Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|database|docs|storage/logs)(/|$) - [F,L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>
<FilesMatch "^(composer\.(json|lock)|README\.md|\.env|\.env\.example)$">
  Require all denied
</FilesMatch>
